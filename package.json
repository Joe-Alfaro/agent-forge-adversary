{
  "name": "agentforge",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-agent adversarial evaluation platform for the OpenEMR Clinical Co-Pilot",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10.9"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "migrate": "node-pg-migrate -m packages/db/migrations",
    "lint": "eslint .",
    "db:import-eval": "node packages/db/dist/scripts/import-eval-results.js"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vitest": "^4.1.11",
    "@types/node": "^22.10.0"
  }
}
