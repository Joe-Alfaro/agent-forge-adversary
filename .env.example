# Platform database
DATABASE_URL=postgres://agentforge:agentforge@localhost:5432/agentforge

# Target under test (confirmed URLs)
COPILOT_BASE_URL=https://copilot-evidence-production.up.railway.app/
OPENEMR_BASE_URL=https://openemr-production-ef61.up.railway.app/

# Shared HMAC secret the Co-Pilot uses to verify patient-scoped tokens. The
# Target Adapter mints tokens with it; operator-supplied, never committed.
COPILOT_TOKEN_SECRET=
# OAuth2 bearer for seeding synthetic patients/documents into OpenEMR.
OPENEMR_TOKEN=

# Per-role Anthropic keys (shared org bill; separate keys for attribution)
ANTHROPIC_API_KEY_REDTEAM=
ANTHROPIC_API_KEY_JUDGE=
ANTHROPIC_API_KEY_DOCS=
ANTHROPIC_API_KEY_ORCHESTRATOR=

# OpenRouter attacker tier (added Thursday, behind a feature flag)
FEATURE_OPENROUTER_ATTACKER=false
OPENROUTER_API_KEY=

# Self-hosted Langfuse (deployed on Railway)
LANGFUSE_BASEURL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Nightly run
NIGHTLY_CRON=0 1 * * *
NIGHTLY_BUDGET_USD=25
RUN_WINDOW_HOURS=3

# Dashboard (single shared operator login for the sprint)
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=
