{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentforge/contracts/nightly_plan/v1",
  "title": "NightlyPlan",
  "description": "The Orchestrator's plan for one nightly (or Run now) run, written to nightly_runs.plan before anything executes: ordered items with estimated cost, the priority-score breakdown for coverage campaigns, the weights used (so decisions are auditable), and what was cut for budget (ARCHITECTURE 7.0, 7.2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "trace_id", "produced_by", "produced_at",
    "trigger", "target_version", "budget_usd", "estimated_cost_usd", "weights",
    "items", "run_count", "cut_count"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "message_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "minLength": 1 },
    "produced_by": { "const": "orchestrator" },
    "produced_at": { "type": "string", "format": "date-time" },
    "trigger": { "enum": ["cron", "run_now"] },
    "target_version": { "type": "string", "minLength": 1 },
    "budget_usd": { "type": "number", "minimum": 0 },
    "estimated_cost_usd": { "type": "number", "minimum": 0 },
    "weights": { "$ref": "#/$defs/scoreTerms" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "run_count": { "type": "integer", "minimum": 0 },
    "cut_count": { "type": "integer", "minimum": 0 },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "scoreTerms": {
      "description": "The six terms of the 7.2 priority score (as weights, or as a cell's normalized term values).",
      "type": "object",
      "additionalProperties": false,
      "required": ["gap", "open", "regress", "yield", "stale", "cost"],
      "properties": {
        "gap": { "type": "number" },
        "open": { "type": "number" },
        "regress": { "type": "number" },
        "yield": { "type": "number" },
        "stale": { "type": "number" },
        "cost": { "type": "number" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "kind", "category", "seed_case_ids", "max_attempts",
        "estimated_cost_usd", "decision", "reason"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "ARCHITECTURE 7.0 order: operator_request, then regression (owed to a changed target or a ticket moved to fixed), then coverage_campaign.",
          "enum": ["operator_request", "regression", "coverage_campaign"]
        },
        "regression_cause": {
          "description": "Why a regression item is owed (kind = regression only).",
          "enum": ["target_changed", "ticket_fixed"]
        },
        "request_id": { "type": "string", "format": "uuid" },
        "request_kind": { "enum": ["rerun", "focus", "skip", "note"] },
        "exploit_id": { "type": "string" },
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": "string", "minLength": 1 },
        "owasp_ids": {
          "description": "OWASP LLM Top 10 (LLMnn) and/or OWASP Top 10 (Ann) ids the item's cell maps to. Optional for backward compatibility; the planner sets it on every coverage_campaign item.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(LLM[0-9]{2}|A[0-9]{2})$" }
        },
        "priority": { "type": "number" },
        "score": { "$ref": "#/$defs/scoreTerms" },
        "seed_case_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "max_attempts": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 },
        "decision": { "enum": ["run", "cut"] },
        "reason": { "type": "string" }
      }
    }
  }
}
