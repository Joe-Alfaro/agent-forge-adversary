{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentforge/contracts/attack_taxonomy/v1",
  "title": "AttackTaxonomyCell",
  "description": "A category x subcategory cell from the shared AttackTaxonomy v1. This is the canonical key set used by evals/, coverage_snapshots, the dashboard Coverage panel, and THREAT_MODEL.md. The first six categories are the PRD minimum; misinformation is a seventh, non-PRD category. The `categories` map below is the machine-readable taxonomy; the `oneOf` validates a {category, subcategory} object.",
  "version": "1",
  "categories": {
    "prompt_injection": ["direct", "indirect", "multi_turn"],
    "data_exfiltration": ["phi_leakage", "cross_patient", "authorization_bypass"],
    "state_corruption": ["conversation_history_manipulation", "context_poisoning"],
    "tool_misuse": ["unintended_invocation", "parameter_tampering", "recursive_calls"],
    "denial_of_service": ["token_exhaustion", "loops", "cost_amplification"],
    "identity_role_exploitation": ["privilege_escalation", "persona_hijacking", "trust_boundary_violation"],
    "misinformation": ["unsupported_claim", "fabricated_citation"]
  },
  "prd_categories": [
    "prompt_injection",
    "data_exfiltration",
    "state_corruption",
    "tool_misuse",
    "denial_of_service",
    "identity_role_exploitation"
  ],
  "type": "object",
  "required": ["category", "subcategory"],
  "properties": {
    "category": { "type": "string" },
    "subcategory": { "type": "string" }
  },
  "oneOf": [
    {
      "properties": {
        "category": { "const": "prompt_injection" },
        "subcategory": { "enum": ["direct", "indirect", "multi_turn"] }
      },
      "required": ["category", "subcategory"]
    },
    {
      "properties": {
        "category": { "const": "data_exfiltration" },
        "subcategory": { "enum": ["phi_leakage", "cross_patient", "authorization_bypass"] }
      },
      "required": ["category", "subcategory"]
    },
    {
      "properties": {
        "category": { "const": "state_corruption" },
        "subcategory": { "enum": ["conversation_history_manipulation", "context_poisoning"] }
      },
      "required": ["category", "subcategory"]
    },
    {
      "properties": {
        "category": { "const": "tool_misuse" },
        "subcategory": { "enum": ["unintended_invocation", "parameter_tampering", "recursive_calls"] }
      },
      "required": ["category", "subcategory"]
    },
    {
      "properties": {
        "category": { "const": "denial_of_service" },
        "subcategory": { "enum": ["token_exhaustion", "loops", "cost_amplification"] }
      },
      "required": ["category", "subcategory"]
    },
    {
      "properties": {
        "category": { "const": "identity_role_exploitation" },
        "subcategory": { "enum": ["privilege_escalation", "persona_hijacking", "trust_boundary_violation"] }
      },
      "required": ["category", "subcategory"]
    },
    {
      "properties": {
        "category": { "const": "misinformation" },
        "subcategory": { "enum": ["unsupported_claim", "fabricated_citation"] }
      },
      "required": ["category", "subcategory"]
    }
  ]
}
