{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentforge/contracts/campaign_plan/v1",
  "title": "CampaignPlan",
  "description": "The Orchestrator's instruction to the Red Team for one campaign: what to attack, how hard, and when to stop. Every case it names carries an OWASP mapping, the one required engineering deliverable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "campaign_id", "trace_id",
    "produced_by", "produced_at", "category", "owasp_llm_ids", "owasp_ids",
    "seed_case_ids", "max_attempts", "max_turns", "budget", "target_version"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "message_id": { "type": "string", "format": "uuid" },
    "campaign_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "minLength": 1 },
    "produced_by": { "const": "orchestrator" },
    "produced_at": { "type": "string", "format": "date-time" },
    "category": { "type": "string", "minLength": 1 },
    "subcategory": { "type": "string", "minLength": 1 },
    "owasp_llm_ids": {
      "description": "OWASP LLM Top 10 identifiers, e.g. LLM01. At least one.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^LLM[0-9]{2}$" }
    },
    "owasp_ids": {
      "description": "OWASP Top 10 (web) identifiers, e.g. A01. At least one.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^A[0-9]{2}$" }
    },
    "seed_case_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "max_turns": { "type": "integer", "minimum": 1 },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "usd"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 }
      }
    },
    "target_version": { "type": "string", "minLength": 1 },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signal_per_dollar_floor": { "type": "number", "minimum": 0 },
        "novelty_floor": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "mutation_strategy": { "type": "string" }
  }
}
